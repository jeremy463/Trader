# Copy to /etc/apex/env (chmod 600). Real values only; never commit this file with secrets.
# Payments: Paystack Dashboard > Settings > API Keys & Webhooks (sk_test_... first, sk_live_... after a full test payment works)
PAYSTACK_SECRET_KEY=
# Market data (set the ones your config uses)
OANDA_TOKEN=                  # OANDA > Manage API Access (a free practice account still serves real prices)
TWELVEDATA_API_KEY=           # optional backup provider
# Email (transactional: verification, resets, receipts, alerts)
SMTP_PASSWORD=
# Optional: MetaTrader 5 terminal login password (admin trading panel, Windows only)
MT5_PASSWORD=
